{
  "name": "dict_app",
  "version": "1.9.3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --win -p always",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "com.antigravity.lumina",
    "productName": "Lumina",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "janzlu",
        "repo": "dict-app",
        "releaseType": "release",
        "timeout": 600000
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-Mac-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron-updater": "^6.8.3"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "jest": "^30.3.0"
  }
}